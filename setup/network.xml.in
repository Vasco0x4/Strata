<!-- Routing is decided only by the Strata firewall, VMs cannot talk to each other,
     no DNS served by the host. Rendered twice: VM network and image-build network. -->
<network xmlns:dnsmasq='http://libvirt.org/schemas/network/dnsmasq/1.0'>
  <name>@NET_NAME@</name>
  <forward mode='open'/>
  <bridge name='@NET_BRIDGE@' stp='off' delay='0'/>
  <port isolated='yes'/>
  <dns enable='no'/>
  <ip address='@NET_PREFIX@.1' prefix='24'>
    <dhcp>
      <range start='@NET_PREFIX@.100' end='@NET_PREFIX@.250'/>
    </dhcp>
  </ip>
  <dnsmasq:options>
    <dnsmasq:option value='dhcp-option=option:dns-server,9.9.9.9,1.1.1.1'/>
    <!-- Match DHCP reservations by MAC: guests (systemd-networkd) send a client-id,
         and without this dnsmasq keys on it and hands out a pool address instead of the
         reserved one that the port-forwards and the anti-spoof filter depend on. -->
    <dnsmasq:option value='dhcp-ignore-clid'/>
  </dnsmasq:options>
</network>
